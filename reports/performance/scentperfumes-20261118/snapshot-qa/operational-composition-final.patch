+
+GOOD={'decision':'approve','summary':'Synthetic','evidence':[],'changes':[]}
+class SmokeContract(unittest.TestCase):
+ def invoke(self,payload):
+  with tempfile.TemporaryDirectory()as tmp:
+   tree=Path(tmp)/'fixture';tree.mkdir();(tree/'fixture.txt').write_text('Synthetic')
+   task={'id':'smoke','role':'smoke','agent':'claude','tier':'fast','read_files':['fixture.txt'],'allowed_files':[]}
+   observed={}
+   def fake(args,prompt,view,**kwargs):
+    observed['args']=args;observed['schema_exists']=(view/'council-response.schema.json').is_file()
+    return {'exit_code':0,'stdout':json.dumps(payload),'stderr':'','process_reaped':True,'context_complete':True}
+   with patch.object(adapters.shutil,'which',return_value='/usr/bin/true'),patch('ipanema.orchestration.isolation.run_isolated',side_effect=fake):
+    result=engine._worker_once(Project(ROOT),{},task,tree,[],{},frozen_prompt='Synthetic fixture')
+   return result,task,observed
+ def test_smoke_uses_native_schema_and_same_safety_flags(self):
