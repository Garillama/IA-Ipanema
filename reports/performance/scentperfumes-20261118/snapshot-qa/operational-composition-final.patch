+            p=self.root/'.agents/skills'/name/'SKILL.md';p.parent.mkdir(parents=True,exist_ok=True);p.write_text('---\nname: '+name+'\ndescription: fixture\n---\n')
+        self.project=Project(self.root)
+
+    def test_registered_skills_load_for_all_catalog_entries(self):
+        names=sorted(AUTHORIZED_SKILLS)
