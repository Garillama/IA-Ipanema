+
+    def test_list_type_entries_and_duplicates_rejected(self):
+        for value in ['ipanema-architect',{},[None],[[]],['ipanema-architect','ipanema-architect']]:
+            with self.subTest(value=value),self.assertRaises(IpanemaError):engine.instruction_context(self.project,{'skills':value})
+
+    def test_missing_authorized_skill_fails_closed(self):
+        (self.root/'.agents/skills/cloudflare-web-perf/SKILL.md').unlink()
