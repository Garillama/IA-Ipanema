+"""Offline controller contracts; mocked dispatch is not provider approval."""
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+from tests.support import make_project
+from ipanema.core import Project,IpanemaError
+from ipanema.coordinator import AUTHORIZED_SKILLS,EXTERNAL_SKILLS,route
+from ipanema.orchestration import engine,planner
+
+class SkillExecutionContract(unittest.TestCase):
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory();self.root=make_project(Path(self.tmp.name),theme=False)
+        self.addCleanup(self.tmp.cleanup)
+        (self.root/'AGENTS.md').write_text('Fixture rules. No remote actions.\n')
+        (self.root/'copy.txt').write_text('Fixture content\n')
+        for name in AUTHORIZED_SKILLS:
+            p=self.root/'.agents/skills'/name/'SKILL.md';p.parent.mkdir(parents=True,exist_ok=True);p.write_text('---\nname: '+name+'\ndescription: fixture\n---\n')
+        self.project=Project(self.root)
+
+    def test_registered_skills_load_for_all_catalog_entries(self):
+        names=sorted(AUTHORIZED_SKILLS)
+        self.assertEqual(set(engine.instruction_context(self.project,{'skills':names})['skills']),set(names))
+
+    def test_router_discovery_external_names_are_authorized(self):
+        for request in ['Optimiza LCP','Auditoría integral de calidad web','Audita SEO canonical','Schema.org ProductGroup']:
