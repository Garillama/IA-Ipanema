+					{% endfor %}
+					<source
+						type="image/{{ srcSet.format }}"
+						{% if image_lazy_js %}data-{% endif %}srcset="{{ source_srcset }}"
+						{% if image_sizes %}sizes="{{ image_sizes }}"{% endif %}
+						{% if image_width %}width="{{ image_width }}"{% endif %}
