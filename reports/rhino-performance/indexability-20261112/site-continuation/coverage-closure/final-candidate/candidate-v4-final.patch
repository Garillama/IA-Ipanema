+            elif key in _VALUE_RULES:
+                errors.append({'reason': 'missing_value', 'directive': key, 'selected_offset': cursor})
+            else:
+                unknown.append({'kind': 'unknown_directive', 'name': key, 'selected_offset': cursor})
