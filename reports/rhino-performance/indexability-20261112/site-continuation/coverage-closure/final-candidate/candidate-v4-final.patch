+        if isinstance(value, dict):
+            value = {k: v[:96] if isinstance(v, str) else v for k, v in value.items()}
+            if 'reason' in value:
+                self.reasons.setdefault(value['reason'], value)
+        if len(self) < MAX_SAMPLES:
+            super().append(value)
+
+    def __iadd__(self, values):
+        for value in values:
+            self.append(value)
+        return self
