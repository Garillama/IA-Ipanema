+_FLAG_RULES = frozenset(('all', 'index', 'follow', 'noindex', 'none', 'nofollow', 'nosnippet',
+    'indexifembedded', 'notranslate', 'noimageindex', 'noarchive', 'nocache', 'nositelinkssearchbox'))
+
+
