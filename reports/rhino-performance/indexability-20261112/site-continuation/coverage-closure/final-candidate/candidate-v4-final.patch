+MAX_SOURCE_BYTES = 2_000_000
+MAX_TOTAL_BYTES = 4_000_000
+MAX_PROCESS_SOURCES = 128
+MAX_RETAINED_SOURCES = 16
+MAX_SAMPLES = 8
+MAX_EVIDENCE_BYTES = 65_536
