@@ -0,0 +1,34 @@
+import copy
+import unittest
+from tests.unit.test_seo_crawler_v4 import CrawlerV4, HOME, doc
+from ipanema.seo.extractor import extract
+from ipanema.seo.indexability import classify
+from ipanema.seo.crawl_policy import Policy
+from ipanema.seo.robots import Robots
+
+class ReviewRegressions(CrawlerV4):
+    def test_preview_none_is_not_noindex(self):
+        for value in ('max-image-preview:none', 'max-image-preview: none', 'max-snippet:-1, max-image-preview:none'):
+            snapshot=extract(doc(extra='<meta name="robots" content="'+value+'">'), HOME,status=200)
+            self.assertEqual(classify(snapshot,googlebot_allowed=True,robots_known=True)['state'],'indexable_candidate')
+        for value in ('none','noindex, nofollow','max-image-preview:none, noindex'):
+            snapshot=extract(doc(extra='<meta name="robots" content="'+value+'">'),HOME,status=200)
+            self.assertEqual(classify(snapshot,googlebot_allowed=True,robots_known=True)['state'],'noindex')
+    def test_robots_product_token(self):
+        robots=Robots();robots.parse(['User-agent: bot','Disallow: /','User-agent: *','Allow: /'])
+        self.assertTrue(robots.can_fetch('Googlebot',HOME))
+        robots=Robots();robots.parse(['User-agent: GoogleBot','Disallow: /','User-agent: *','Allow: /'])
+        self.assertFalse(robots.can_fetch('Googlebot',HOME))
+    def test_late_exclusion_still_partial(self):
+        links='<a href="https://other.invalid/">External</a>'*2001+'<a href="/deep">Deep</a>'
+        xml='<urlset><url><loc>'+HOME+'</loc></url></urlset>'
+        result=self.run_crawl({HOME:{'status':200,'body':doc(links=links)},HOME+'sitemap.xml':{'status':200,'body':xml}},max_depth=0)
+        self.assertEqual(result['state'],'partial')
+    def test_unchecked_sitemap_never_complete(self):
+        xml='<urlset><url><loc>'+HOME+'unlinked</loc></url></urlset>'
+        result=self.run_crawl({HOME:{'status':200,'body':doc()},HOME+'sitemap.xml':{'status':200,'body':xml}},max_urls=1)
+        self.assertEqual(result['state'],'partial')
+    def test_content_route_containing_action_word(self):
+        self.assertEqual(Policy(HOME).check('/blog/posts/como-comprar-x'),HOME+'blog/posts/como-comprar-x')
+        for path in ('/comprar/','/cart/add','/add_to_cart','/%2561ccount'):
+            with self.assertRaises(ValueError):Policy(HOME).check(path)
