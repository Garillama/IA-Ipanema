+def has_noindex(directives):
+    # Consume known key:value directives as a single item; preview:none is not none.
+    pattern = r"([a-z][a-z0-9_-]*)(?:\s*:\s*(?:\"[^\"]*\"|'[^']*'|[^,;\s]+))?"
+    return any(m[1] in ('none', 'noindex') for m in re.finditer(pattern, directives.lower()))
