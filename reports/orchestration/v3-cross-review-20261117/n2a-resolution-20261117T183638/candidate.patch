+    def principal(self, agent, supersedes=()):
+        return {'provider':agent,'actor_kind':'principal','parent_actor_id':None,
+                'capability_verified':'code_review_readonly','supersedes_review_ids':list(supersedes)}
+
+    def add(self, ident, kind, *, alternative=True, qa_report=None, principal=None, resolution_state=None, **extra):
+        # Legacy source/qa intentionally omit alternative_sha256 as real producers do.
+        row={'id':ident,'kind':kind,'executed':True,'passed':True,'sha256':'f'*64,
+             'context':copy.deepcopy(self.c['context']),**extra}
+        if alternative:row['alternative_sha256']=cr.fingerprint(self.c)
+        self.evidence.append(row)
+        self.bindings.append(cr.bind_receipt(row,self.c,root=self.root,permissions=self.permissions,
+                                            qa_report=qa_report,principal=principal,resolution_state=resolution_state,
+                                            objection_identity=self.record()['identity'] if kind=='resolution' else None))
+        if principal:self.controller.attest(self.bindings[-1],principal['provider'])
+        return row
+
+    def review(self, agent):
+        body={'candidate_sha256':cr.fingerprint(self.c),'reviewed_files':['sample.py'],
+              'decision':'approve','summary':'Synthetic reviewer only',
+              'challenges':{k:{'status':'pass','evidence_refs':['source:sample.py'],'notes':'fixture'}
+                            for k in cr.CHALLENGES},'objections':[]}
+        env={'requested_agent':agent,'effective_agent':agent,'response':body,'attempt_ref':'attempt-'+agent}
+        self.add(env['attempt_ref'],'constraint',constraint='review_transport',reviewer=agent,
+                 phase='independent_code_review',response_sha256=cr._hash(body),principal=self.principal(agent))
+        return env
+
+    def refresh(self, env, supersedes=()):
+        row=next(r for r in self.evidence if r['id']==env['attempt_ref']);row['response_sha256']=cr._hash(env['response'])
+        b=cr.bind_receipt(row,self.c,root=self.root,permissions=self.permissions,
+                          principal=self.principal(env['effective_agent'],supersedes))
+        self.bindings=[x for x in self.bindings if x['receipt_id']!=row['id']]+[b]
+        self.controller.attest(b,env['effective_agent'],supersedes)
+
+    def evaluate(self):
+        if self.controller.auto_history:self.controller.rows=copy.deepcopy(self.history)
+        return review_code_candidate(self.c,self.reviews,evidence=self.evidence,root=self.root,
+                                     answers=self.answers,bindings=self.bindings,review_history=self.history,controller=self.controller)
