+class MaterialIncrementTests(unittest.TestCase):
+    principal=FindingsResolution.principal
+    add=FindingsResolution.add
+    review=FindingsResolution.review
+    refresh=FindingsResolution.refresh
+    evaluate=FindingsResolution.evaluate
+    resolution=FindingsResolution.resolution
+    record=FindingsResolution.record
+
+    def objection(self):
+        obj=FindingsResolution.objection(self)
+        obj['claim']=self.claim
+        if getattr(self,'extra_ref',None):obj['evidence_refs'].append(self.extra_ref)
+        return obj
+
+    def setUp(self):
+        self.claim='sample.py has 0 function definitions'
+        FindingsResolution.setUp(self)
+        self.controller.auto_material=False;self.controller.auto_records=False
+        self.reviews[0]['response']['objections']=[self.objection()];self.refresh(self.reviews[0])
+
+    def answered(self):
+        return cr.advance_objection(self.record(),'author_answer',actor='codex',candidate_sha256=cr.fingerprint(self.c))
+
+    def demonstrated(self, kind='documented_refutation',baseline=0):
+        rec=self.answered()
+        proof=self.controller.prepare_material(rec,['source:sample.py'],kind=kind,baseline=baseline,metric='function_count')
+        self.assertIsNotNone(proof)
+        rec=cr.advance_objection(rec,'add_evidence',actor='controller',candidate_sha256=cr.fingerprint(self.c),evidence_refs=['source:sample.py'],controller=self.controller)
+        return rec,proof
+
+    def finish(self, rec):
+        rec=cr.advance_objection(rec,'request_review',actor='controller',candidate_sha256=cr.fingerprint(self.c))
+        b=self.resolution()
+        rec=cr.advance_objection(rec,'refute',actor='claude',candidate_sha256=cr.fingerprint(self.c),evidence_refs=[b['receipt_id']],confirmation=b,controller=self.controller)
+        self.controller.records[rec['identity']]=rec
+        return self.evaluate()
+
+    def test_repeated_original_reference_without_demonstration_rejected(self):
+        b=self.resolution()
+        self.assertIsNotNone(self.controller.attestation(b['receipt_id']))
+        rec=self.answered()
+        with self.assertRaises(IpanemaError):
+            cr.advance_objection(rec,'add_evidence',actor='controller',candidate_sha256=cr.fingerprint(self.c),evidence_refs=self.objection()['evidence_refs'],controller=self.controller)
+        self.assertEqual(self.evaluate()['state'],'changes_requested')
+
+    def test_forged_new_reference_is_not_material(self):
+        row=next(r for r in self.evidence if r['id']=='source:sample.py')
+        self.add('renamed-source','source',subject='sample.py',sha256=row['sha256'],alternative=False)
+        with self.assertRaises(IpanemaError):
+            cr.advance_objection(self.answered(),'add_evidence',actor='controller',candidate_sha256=cr.fingerprint(self.c),evidence_refs=['renamed-source'],controller=self.controller)
+
+    def test_changed_id_and_hash_with_no_counterexample_are_insufficient(self):
+        # A different artifact string/hash says count==1, which agrees with the observation;
+        # the controller computes the fact and refuses to call this a refutation.
+        self.claim='sample.py has 1 function definitions'
+        rec=self.answered();source=(self.root/'sample.py').read_bytes()
+        proof=self.controller.prepare_material(rec,['source:sample.py'],kind='documented_refutation',baseline=1,metric='function_count')
+        self.assertIsNone(proof)
+        self.assertEqual(sum(line.startswith(b'def ') for line in source.splitlines()),1)
+        with self.assertRaises(IpanemaError):
+            cr.advance_objection(rec,'add_evidence',actor='controller',candidate_sha256=cr.fingerprint(self.c),evidence_refs=['source:sample.py'],controller=self.controller)
+
+    def test_refutation_uses_existing_unchanged_source_and_same_reference(self):
+        before=hashlib.sha256((self.root/'sample.py').read_bytes()).hexdigest()
+        rec,proof=self.demonstrated()
+        self.assertEqual(proof.kind,'documented_refutation')
+        self.assertEqual(proof.evidence_refs,tuple(self.objection()['evidence_refs']))
+        self.assertEqual(rec['original_evidence_refs'],self.objection()['evidence_refs'])
+        result=self.finish(rec)
+        self.assertEqual(result['state'],'synthetic_pass');self.assertTrue(result['findings'][0]['closed'])
+        self.assertFalse(result['authorization_ready'])
+        self.assertEqual(before,hashlib.sha256((self.root/'sample.py').read_bytes()).hexdigest())
+
+    def test_new_measured_fact_permits_legitimate_review(self):
+        self.claim='function count has not been measured'
