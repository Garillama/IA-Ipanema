+        rec,proof=self.demonstrated(kind='new_fact',baseline=None)
+        self.assertEqual(proof.kind,'new_fact')
+        self.assertEqual(self.finish(rec)['state'],'synthetic_pass')
+
+    def test_unrelated_claim_does_not_receive_refutation_proof(self):
