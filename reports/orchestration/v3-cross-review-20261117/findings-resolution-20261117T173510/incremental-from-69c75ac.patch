+                            for k in cr.CHALLENGES},'objections':[]}
+        env={'requested_agent':agent,'effective_agent':agent,'response':body,'attempt_ref':'attempt-'+agent}
+        self.add(env['attempt_ref'],'constraint',constraint='review_transport',reviewer=agent,
+                 phase='independent_code_review',response_sha256=cr._hash(body),principal=self.principal(agent))
+        return env
