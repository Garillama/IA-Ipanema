+        b=cr.bind_receipt(row,self.c,root=self.root,permissions=self.permissions,
+                          principal=self.principal(env['effective_agent'],supersedes))
+        self.bindings=[x for x in self.bindings if x['receipt_id']!=row['id']]+[b]
