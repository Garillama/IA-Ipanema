+    def add(self, ident, kind, *, alternative=True, qa_report=None, principal=None, resolution_state=None, **extra):
+        # Legacy source/qa intentionally omit alternative_sha256 as real producers do.
+        row={'id':ident,'kind':kind,'executed':True,'passed':True,'sha256':'f'*64,
+             'context':copy.deepcopy(self.c['context']),**extra}
+        if alternative:row['alternative_sha256']=cr.fingerprint(self.c)
+        self.evidence.append(row)
