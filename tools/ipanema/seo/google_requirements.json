      },
      "ListItem": {
        "required": [
          "position",
          "name",
          "item"
        ],
        "last_item_item_optional": true
      }
    },
    "carousel": {
      "source": "https://developers.google.com/search/docs/appearance/structured-data/carousel",
      "eligible_content_types": [
        "Course",
        "Movie",
        "Recipe",
        "Restaurant"
      ],
      "ItemList": {
        "required": [
          "itemListElement"
        ],
        "min_items": 2
      },
      "ListItem": {
        "required": [
          "position"
        ],
        "summary_page_requires": [
          "url"
        ]
      },
      "notes": [
        "Carrusel tradicional: no confundir con carousels-beta. ItemList de productos por sí solo no habilita esta función."
      ]
    },
    "article": {
      "source": "https://developers.google.com/search/docs/appearance/structured-data/article",
      "applies_to_page_types": [
        "post"
      ],
      "required": [],
      "recommended": [
        "author",
        "author.name",
        "author.url",
        "headline",
        "image",
        "datePublished",
        "dateModified"
      ],
      "constraints": [
        "author debe ser Person u Organization, un objeto por autor.",
        "datePublished y dateModified en ISO 8601 con zona horaria.",
        "La imagen no debe ser un logotipo."
      ]
    },
    "faq": {
      "source": "https://developers.google.com/search/updates#may-2026",
      "status": "retired",
      "notes": [
        "El resultado enriquecido FAQ dejó de mostrarse el 2026-05-07 y su documentación se retiró el 2026-06-15. FAQPage sigue siendo vocabulario schema.org válido, pero no debe proponerse como beneficio de presentación en Google."
      ]
